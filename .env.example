# App login (required before exposing online)
AUTH_USER=admin
AUTH_PASSWORD=change-me-now
SESSION_SECRET=generate-a-long-random-string

# Set to 1 when serving over HTTPS (Tailscale Serve / Cloudflare Tunnel HTTPS)
# COOKIE_SECURE=1

# OpenAI-compatible LLM (also editable in System Settings UI)
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Server
PORT=8787

# GV Chrome profile / debug port (Linux VPS often needs DISPLAY=:99)
# DISPLAY=:99
# GV_PROFILE=
# GV_DEBUG_PORT=9222
# CHROME_PATH=
