# App login (required before exposing online)
AUTH_USER=admin
AUTH_PASSWORD=change-me-now
SESSION_SECRET=generate-a-long-random-string

# Set to 1 when serving over HTTPS (Tailscale Serve / Cloudflare Tunnel HTTPS)
# COOKIE_SECURE=1

# OpenAI-compatible LLM (also editable in System Settings UI)
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Server
PORT=8787

# GV Chrome profile / debug port (Linux VPS often needs DISPLAY=:99)
# DISPLAY=:99
# GV_PROFILE=
# GV_DEBUG_PORT=9222
# CHROME_PATH=

# noVNC page embedded by Reconnect GV (/gv-login).
# A base URL is enough — the server opens vnc.html and forces resize=scale.
# resize=scale fits the remote desktop in the iframe, so noVNC's hand/pan tool
# is intentionally unused (that tool only pans when scaling is off and the
# framebuffer is larger than the browser view).
#
# 127.0.0.1 is this machine. It works when you open Wingman on the VPS itself.
# From a phone, 127.0.0.1 is the phone — point this at a URL the phone can
# reach, or reverse-proxy noVNC onto the Wingman origin and use a relative path:
#   GV_NOVNC_URL=/novnc/
#   GV_NOVNC_URL=http://wingman.tailnet.ts.net:6080/
# Keep port 6080 off the public internet (localhost or Tailscale only).
# GV_NOVNC_URL=http://127.0.0.1:6080/

# Admin-only "Restart GV Chrome" button on Reconnect GV. Off unless set to 1.
# Runs scripts/restart-gv-chrome.sh (start-gv-chrome.sh no-ops when CDP is
# already up, so it cannot unstick a wedged window). If GV_CHROME_SYSTEMD_UNIT
# is set, runs `systemctl restart` on that unit instead — the name is validated
# and the request body cannot choose the command. No sudo. The Node user must
# be allowed to restart the unit without a password prompt.
# TODO: leave this unset unless that Node user is the admin who owns the GV profile.
# GV_CHROME_RESTART=1
# GV_CHROME_SYSTEMD_UNIT=gv-chrome.service
# GV_CHROME_SYSTEMD_USER=1
