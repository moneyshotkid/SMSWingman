# App login (required before exposing online)
AUTH_USER=admin
AUTH_PASSWORD=change-me-now
SESSION_SECRET=generate-a-long-random-string

# Set to 1 when serving over HTTPS (Tailscale Serve / Cloudflare Tunnel HTTPS)
# COOKIE_SECURE=1

# Moonshot / Kimi (OpenAI-compatible)
MOONSHOT_API_KEY=sk-your-key-here

# Optional overrides (also editable in System Settings UI)
# LLM_BASE_URL=https://api.moonshot.ai/v1
# LLM_MODEL=kimi-k2

# Server
PORT=8787

# Google Voice Chrome profile / debug port
# GV_PROFILE=
# GV_DEBUG_PORT=9222
# CHROME_PATH=
